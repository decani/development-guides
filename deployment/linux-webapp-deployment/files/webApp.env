# TEMPLATE - replace all <...> placeholders before use.
# Keep passwords and other secrets out of source control.

Deployment=production

DatabaseHost=localhost
DatabasePort=5432
DatabaseName=<DATABASE_NAME>
DatabaseUserName=<DATABASE_USER>
DatabaseUserPassword=<DATABASE_PASSWORD>

WebAppServerHttpPort=<HTTP_PORT>

# Optional application-level authentication. Remove if not used.
WebAppUserName=<WEBAPP_USER>
WebAppUserPassword=<WEBAPP_PASSWORD>

LogFilePath=/opt/<APP_NAME>/deployments/<DEPLOYMENT_NAME>/logs
