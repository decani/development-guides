# TEMPLATE - replace placeholders and remove unused application properties.
# Install as /opt/dks/<APP_NAME>/config/webApp.env with root:appmgr, mode 640.
# Bash syntax: quote values containing spaces or special characters.
# Keep production secrets outside Git.

Deployment=production
DatabaseHost=localhost
DatabasePort=5432
DatabaseName=<DATABASE_NAME>
DatabaseUserName=<DATABASE_USER>
DatabaseUserPassword='<DATABASE_PASSWORD>'
WebAppServerHttpPort=<HTTP_PORT>
LogFilePath=/opt/dks/<APP_NAME>/logs

# Add application-specific properties here, for example:
# supportEmailAddress='address@example.com'
